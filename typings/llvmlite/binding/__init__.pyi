# Typed surface of llvmlite 0.46.0 that static-penryn uses: LLVM's
# integrated assembler, reached through module-level inline assembly.
from typing import Literal

def initialize_native_target() -> None: ...
def initialize_native_asmprinter() -> None: ...
def initialize_native_asmparser() -> None: ...

class ModuleRef: ...

def parse_assembly(llvmir: str, context: None = None) -> ModuleRef: ...

class TargetMachine:
    def emit_object(self, module: ModuleRef) -> bytes: ...

class Target:
    @classmethod
    def from_triple(cls, triple: str) -> Target: ...
    def create_target_machine(
        self,
        *,
        reloc: Literal['default', 'static', 'pic', 'dynamicnopic'] = 'default',
        codemodel: Literal['jitdefault', 'small', 'kernel', 'medium', 'large', 'default'] = 'jitdefault',
    ) -> TargetMachine: ...
