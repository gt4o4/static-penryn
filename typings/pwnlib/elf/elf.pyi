# Typed surface of pwntools 4.15.0's ELF that static-penryn uses.
from mmap import mmap

from elftools.elf.elffile import ELFFile

class ELF(ELFFile):
    mmap: mmap
    def __init__(self, path: str, checksec: bool = True) -> None: ...
    @property
    def data(self) -> bytes: ...
    def read(self, address: int, count: int) -> bytes: ...
    def write(self, address: int, data: bytes) -> None: ...
    def close(self) -> None: ...
